# ═══════════════════════════════════════════
#  URO — Environment Variables
# ═══════════════════════════════════════════
# Copy this file to .env and fill in the values.

# Discord Bot Token
# Get it from: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Google Gemini API Key
# Get it from: https://ai.google.dev/gemini-api/docs
GEMINI_API_KEY=your_gemini_api_key_here

# Bot Channel ID (optional — the channel where bot always responds)
# Right-click a channel in Discord > Copy Channel ID (enable Developer Mode first)
BOT_CHANNEL_ID=your_channel_id_here
