# ═══════════════════════════════════════════
#  URO — Environment Variables
# ═══════════════════════════════════════════
# Copy this file to .env and fill in the values.

# Discord Bot Token
# Get it from: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Google Gemini API Keys (comma-separated for automatic key rotation)
# Get them from: https://ai.google.dev/gemini-api/docs
# Example: GEMINI_API_KEYS=key1,key2,key3
GEMINI_API_KEYS=your_gemini_api_key_here

# Bot Channel ID (the channel where the bot always responds)
# Right-click a channel in Discord > Copy Channel ID (enable Developer Mode first)
BOT_CHANNEL_ID=your_channel_id_here
